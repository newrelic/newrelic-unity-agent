<?xml version="1.0"?>
<dependencies>
  <androidPackages>
    <androidPackage spec="com.newrelic.agent.android:agent-ndk:1.1.5"/>
    <androidPackage spec="com.newrelic.agent.android:android-agent:7.8.2">
        </androidPackage>
  </androidPackages>
  <iosPods>
    <iosPod name="NewRelicAgent" version="~&gt; 7.7.7" minTargetSdk="11.0">
      <sources>
        <source>https://github.com/CocoaPods/Specs</source>
      </sources>
    </iosPod>
  </iosPods>
  <!--
    A <remoteSwiftPackage> declaration for newrelic-ios-agent-spm was removed
    here in plugin 1.7.0. EDM4U's Swift Package Manager resolver links package
    products against the UnityFramework target only and never embeds them in
    the built .app, so the dynamic NewRelic.framework was missing at runtime
    and the app crashed on launch with:

      Library not loaded: @rpath/NewRelic.framework/NewRelic

    Because EDM4U enables SPM by default, that was the default iOS path.
    See https://github.com/newrelic/newrelic-unity-agent/issues/82 and the
    upstream bug https://github.com/googlesamples/unity-jar-resolver/issues/779.

    Do not re-add this block until the agent ships a post-build step that
    embeds and code-signs the framework on the main Unity-iPhone target, or
    the upstream issue is fixed. iOS dependencies resolve via CocoaPods above.
  -->
</dependencies>
